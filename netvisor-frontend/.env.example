# Backend API URL (proxied by Vite in dev mode).
# Production builds: use `npm run build:prod` — it bakes VITE_API_URL=/backend/api
# for sub-URI deployments. Do NOT build prod with a bare /api value.
VITE_API_URL=/api

# NOTE: no Google client ID needed here — the frontend fetches it at runtime
# from GET /api/config (single source of truth, backend-configured).
