# NetVisor Backend Configuration
# All variables use NETVISOR_ prefix

# JWT Secret (CHANGE THIS in production!)
NETVISOR_JWT_SECRET=dev-secret-change-me

# Google OAuth Client ID (get from https://console.cloud.google.com/apis/credentials)
NETVISOR_GOOGLE_CLIENT_ID=

# CORS Origins (comma-separated)
# NETVISOR_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]