# NetVisor backend — environment template.
# Copy to netvisor-backend/.env and fill in real values.
# .env is gitignored — NEVER commit real secrets.

# Auth — required in production (openssl rand -hex 32)
NETVISOR_JWT_SECRET=

# Google OAuth — client ID from Google Cloud Console (Credentials → OAuth 2.0 Client).
# Leave empty to hide Google sign-in; local accounts still work.
NETVISOR_GOOGLE_CLIENT_ID=

# Optional overrides (all settings in src/config.py accept a NETVISOR_ prefix)
# NETVISOR_MAX_UPLOAD_BYTES=5242880          # upload cap in bytes (default 5 MB)
# NETVISOR_PACKET_SOURCE=scapy               # force engine: tshark | scapy (empty = auto-detect)
# NETVISOR_AUTH_TOKEN_EXPIRE_DAYS=7          # auth cookie lifetime in days
# NETVISOR_CORS_ORIGINS=["https://your-domain.example"]
# NETVISOR_STATIC_DIR=/path/to/frontend/dist # serve built frontend from the API

# AI assistant (slice 1) — all optional. Enterprise mode is active iff
# NETVISOR_LLM_API_KEY is set. Personal BYO-key mode additionally needs
# NETVISOR_ENCRYPTION_KEY (Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# NETVISOR_LLM_API_KEY=                      # enterprise key for all logged-in users
# NETVISOR_LLM_PROVIDER=openai               # openai (any OpenAI-compatible) | anthropic
# NETVISOR_LLM_BASE_URL=                     # override endpoint (OpenRouter, vLLM, Ollama...)
# NETVISOR_LLM_MODEL=                        # model id (practically required in enterprise mode)
# NETVISOR_LLM_ALLOW_PERSONAL_KEYS=true      # false = force everyone onto the enterprise key
# NETVISOR_LLM_RATE_LIMIT_15MIN=20           # questions/user/15min on the enterprise key; 0 = unlimited
# NETVISOR_LLM_ENABLED=true                  # kill-switch
# NETVISOR_ENCRYPTION_KEY=                   # Fernet key, required for personal-key storage
